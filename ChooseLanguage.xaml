<Window x:Class="Hangman.ChooseLanguage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hangman"
        mc:Ignorable="d"
        Title="Choose Your Language"
        Height="220" Width="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Choose:" FontSize="20" Margin="5"/>
            <RadioButton x:Name="AE" Content="American English" FontSize="20" IsChecked="True" Margin="5"/>
            <RadioButton x:Name="BE" Content="British English" FontSize="20" Margin="5"/>
            <Button Content="OK" Width="75" Margin="0,20,0,0" Click="OK_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
